# Lista de pendientes (sustituye a las auditorías): se mantiene fuera del repo a propósito.
# Este repo es público y la lista incluye huecos de seguridad aún abiertos. Las auditorías
# de seguridad anteriores también quedaban fuera porque documentaban credenciales expuestas.
PENDIENTES.md
SECURITY_AUDIT.md
SECURITY_AUDIT_V2.md
AUDIT.md

# Environment
.env
backend/src/Toner.Api/appsettings.Development.json

# Certificado autofirmado de Postgres local (generado por docker/postgres/generate-certs.sh)
docker/postgres/server.crt
docker/postgres/server.key

# OS
.DS_Store

# Claves privadas (cuenta de servicio de Firebase, etc.): nunca se versionan.
secrets/
mobile/android/app/google-services.json
mobile/ios/Runner/GoogleService-Info.plist
# Copias comprimidas de secretos y almacenes de claves/certificados privados (H-01).
*.zip
*.pem
*.pfx
*.p12

# Script manual de dev con la contraseña del rol toner_app en claro: nunca se versiona.
docker/postgres/manual-create-app-role.sql
